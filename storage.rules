rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Yordamchi funksiyalar
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'superadmin'];
    }
    
    // Products rasmlari - hamma o'qiy oladi, faqat admin yoza oladi
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Banners rasmlari
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Brands rasmlari
    match /brands/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Foydalanuvchi profil rasmlari
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // Boshqa barcha fayllar - yopiq
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
