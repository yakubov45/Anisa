rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Yordamchi funksiyalar
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'admin' || getUserData().role == 'superadmin');
    }

    function isDelivery() {
      return isAuthenticated() && getUserData().role == 'delivery';
    }
    
    // 1. Users kolleksiyasi
    match /users/{userId} {
      // O'zini o'qish/yozish mumkin, admin hammani o'qiy oladi/yoza oladi
      allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // 2. Ochiq ma'lumotlar (Barcha o'qiy oladi, faqat admin yoza oladi)
    match /products/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /stores/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /prebuilts/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /preBuiltSystems/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /banners/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /brands/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /currency/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /flashDeals/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /flash-deals/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /pcBuilderHero/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /pc-builder-hero/{document=**} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{document=**} { allow read: if true; allow write: if isAdmin(); }
    
    // 3. Orders kolleksiyasi
    match /orders/{orderId} {
      // O'zining buyurtmasini o'qish yoki admin/delivery o'qishi
      allow read: if isAdmin() || 
                  isDelivery() || 
                  (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                  (resource == null);
                  
      // Buyurtma yaratish hammaga ruxsat (Mehmonlar ham buyurtma bera oladi)
      allow create: if true;
      
      // O'zgartirish/O'chirish
      allow update: if isAdmin() || isDelivery() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }
    
    // 4. Reviews kolleksiyasi
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
    
    // 5. Userga bog'langan shaxsiy kolleksiyalar
    match /wishlist/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.resource.data.userId == request.auth.uid || isAdmin());
    }
    match /carts/{docId} {
      allow read, write: if isAuthenticated() && (request.auth.uid == resource.data.userId || request.resource.data.userId == request.auth.uid || isAdmin());
    }

    // 6. Logs (Faqat admin)
    match /logs/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin(); // Only admins should write logs directly from client, others via Server Actions
    }
    
    // Qolgan barcha ma'lumotlarni yopish
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
